# Copie para .env.local (local) ou cadastre na Vercel (Settings → Environment Variables).
# Configure pelo menos UM destino de pedidos: Resend ou planilha. Pode usar os dois.

# E-mail que recebe os pedidos
PEDIDOS_EMAIL=alefribeiroadm@gmail.com

# Resend (resend.com) — chave da conta. Sem domínio próprio verificado,
# o Resend só entrega pro e-mail com que você criou a conta.
RESEND_API_KEY=
# Opcional, depois de verificar um domínio no Resend:
# RESEND_FROM=Vitrine Origo <pedidos@seudominio.com.br>

# Planilha Google — URL /exec do Apps Script (ver planilha-pedidos.gs)
PEDIDOS_PLANILHA_URL=

# Número do botão "Falar com o Alef" (só dígitos, com 55 + DDD)
NEXT_PUBLIC_WHATSAPP_NUMERO=5527997656489
